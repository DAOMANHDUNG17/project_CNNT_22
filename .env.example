NODE_ENV=development
HOST=127.0.0.1
PORT=3000

PGHOST=127.0.0.1
# Independent test cluster; main rollout is a separate manual operation.
PGPORT=5433
PGDATABASE=smart_warehouse_phase3_test
PGUSER=warehouse_readonly
PGPASSWORD=
PGSCHEMA=public
PGPOOL_MAX=5
PGCONNECT_TIMEOUT_MS=5000
PGQUERY_TIMEOUT_MS=5000

# Writer shares PGHOST/PGPORT/PGDATABASE/PGSCHEMA and pool/timeouts above.
# Both runtime roles are restricted; neither is an administrator.
WRITE_PGUSER=warehouse_backend
WRITE_PGPASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=warehouse_session
REDIS_PASSWORD=

# Exact frontend origins, comma separated; no paths or trailing slashes.
# Frontend uses a same-origin /api development proxy; no CORS middleware.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000
# Production always enforces Secure cookies and HTTPS allowed origins.
# Cookie name is warehouse_session (HTTP), __Host-warehouse_session (Secure).
# HttpOnly; SameSite=Lax; Path=/; idle 30 minutes, absolute 8 hours (fixed).
SESSION_SECURE=false

# Optional alternatives to the three blank secrets above; files contain only
# the exact secret, without BOM/newlines. *_FILE takes precedence when set.
# PGPASSWORD_FILE=infra/phase3/local/reader-password.txt
# WRITE_PGPASSWORD_FILE=infra/phase3/local/backend-password.txt
# REDIS_PASSWORD_FILE=infra/phase3/local/redis-session-password.txt
# Select a separate configuration without editing the main .env:
# APP_ENV_FILE=infra/phase3/local/backend.env
