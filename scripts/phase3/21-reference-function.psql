\set ON_ERROR_STOP on
-- REVIEW ONLY. Exact phase2 reference, test cluster only, never a production rollback.
BEGIN;
\ir guard-test.psql
DO $guard$
BEGIN
  IF to_regprocedure('public.record_stock_movement(uuid,bigint,character varying,character varying,character varying,integer)') IS NOT NULL
     OR EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid=to_regclass('public.stock_transactions')
                AND attname='request_scan_code' AND NOT attisdropped) THEN
    RAISE EXCEPTION 'Reference install only: do not overwrite an existing or hardened function';
  END IF;
END
$guard$;
CREATE OR REPLACE FUNCTION public.record_stock_movement(p_transaction_id uuid, p_user_id bigint, p_scan_point_id character varying, p_scan_code character varying, p_movement_type character varying, p_quantity_packages integer)
 RETURNS TABLE(result_status text, current_inventory bigint)
 LANGUAGE plpgsql
AS $function$
DECLARE
    v_user_role VARCHAR(20);
    v_product_id VARCHAR(20);
    v_unit_id BIGINT;
    v_factor INTEGER;
    v_base_qty BIGINT;
    v_current BIGINT;
    v_delta BIGINT;
    v_inserted UUID;
    v_prior stock_transactions%ROWTYPE;
BEGIN
    SELECT role INTO v_user_role FROM users
     WHERE user_id=p_user_id AND is_active=TRUE;
    IF v_user_role IS NULL THEN
        RAISE EXCEPTION 'Invalid or inactive user';
    END IF;
    IF v_user_role NOT IN ('ADMIN','KEEPER','STAFF') THEN
        RAISE EXCEPTION 'Permission denied: read-only user';
    END IF;
    IF NOT EXISTS (SELECT 1 FROM scan_points
                   WHERE scan_point_id=p_scan_point_id AND is_active=TRUE) THEN
        RAISE EXCEPTION 'Unknown/inactive scan point';
    END IF;
    IF p_movement_type IS NULL OR p_movement_type NOT IN ('IN','OUT') THEN
        RAISE EXCEPTION 'Invalid movement type';
    END IF;
    IF p_quantity_packages IS NULL OR p_quantity_packages <= 0 THEN
        RAISE EXCEPTION 'Quantity must be positive';
    END IF;

    SELECT pu.product_id, pu.product_unit_id, pu.conversion_factor
      INTO v_product_id, v_unit_id, v_factor
      FROM product_units pu JOIN products p ON p.product_id=pu.product_id
     WHERE pu.scan_code=p_scan_code AND p.is_active=TRUE;
    IF v_product_id IS NULL THEN
        RAISE EXCEPTION 'Unknown or inactive scan code';
    END IF;
    v_base_qty := p_quantity_packages::BIGINT * v_factor::BIGINT;
    v_delta := CASE WHEN p_movement_type='IN' THEN v_base_qty ELSE -v_base_qty END;

    -- Serialize changes to the same product to prevent concurrent lost updates.
    SELECT quantity_base INTO v_current FROM inventory
      WHERE product_id=v_product_id FOR UPDATE;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Missing inventory row';
    END IF;

    -- Idempotency: reuse of same transaction ID with identical payload is safe.
    SELECT * INTO v_prior FROM stock_transactions
     WHERE transaction_id=p_transaction_id;
    IF FOUND THEN
        IF v_prior.product_id=v_product_id AND v_prior.product_unit_id=v_unit_id
           AND v_prior.user_id=p_user_id AND v_prior.scan_point_id=p_scan_point_id
           AND v_prior.movement_type=p_movement_type
           AND v_prior.quantity_packages=p_quantity_packages THEN
            RETURN QUERY SELECT 'DUPLICATE'::TEXT, v_prior.inventory_after;
            RETURN;
        END IF;
        RAISE EXCEPTION 'Transaction ID reused with different payload';
    END IF;

    -- ON CONFLICT protects the unique ID even for concurrent requests
    -- targeting different products (which lock different inventory rows).
    INSERT INTO stock_transactions (
       transaction_id, product_id, product_unit_id, scan_point_id, user_id,
       movement_type, quantity_packages, conversion_factor_snapshot, inventory_after
    ) VALUES (
       p_transaction_id, v_product_id, v_unit_id, p_scan_point_id, p_user_id,
       p_movement_type, p_quantity_packages, v_factor, v_current
    ) ON CONFLICT (transaction_id) DO NOTHING
    RETURNING transaction_id INTO v_inserted;
    IF v_inserted IS NULL THEN
        SELECT * INTO v_prior FROM stock_transactions
         WHERE transaction_id=p_transaction_id;
        IF v_prior.product_id=v_product_id AND v_prior.product_unit_id=v_unit_id
           AND v_prior.user_id=p_user_id AND v_prior.scan_point_id=p_scan_point_id
           AND v_prior.movement_type=p_movement_type
           AND v_prior.quantity_packages=p_quantity_packages THEN
            RETURN QUERY SELECT 'DUPLICATE'::TEXT, v_prior.inventory_after;
            RETURN;
        END IF;
        RAISE EXCEPTION 'Transaction ID reused with different payload';
    END IF;

    UPDATE inventory
       SET quantity_base=quantity_base+v_delta, updated_at=now()
     WHERE product_id=v_product_id AND quantity_base+v_delta >= 0
    RETURNING quantity_base INTO v_current;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Insufficient inventory';
    END IF;
    UPDATE stock_transactions SET inventory_after=v_current
     WHERE transaction_id=p_transaction_id;
    RETURN QUERY SELECT 'CREATED'::TEXT, v_current;
END;
$function$;

COMMIT;
