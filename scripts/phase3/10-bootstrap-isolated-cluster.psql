\set ON_ERROR_STOP on
-- REVIEW ONLY. Run against postgres at 127.0.0.1:5433 after separate approval.
-- Required psql variable: -v phase3_approval=approved-isolated-phase3
-- An unset variable is a syntax error and ON_ERROR_STOP stops before DDL.
SELECT set_config('phase3.bootstrap_approval', :'phase3_approval', false) AS approval;
DO $guard$
BEGIN
  IF current_database() <> 'postgres' OR current_user <> 'postgres'
     OR session_user <> 'postgres'
     OR current_setting('phase3.bootstrap_approval') <> 'approved-isolated-phase3'
     OR current_setting('server_version_num')::integer / 10000 <> 17
     OR EXISTS (SELECT 1 FROM pg_database WHERE datname IN ('smart_warehouse','smart_warehouse_phase3_test'))
     OR EXISTS (SELECT 1 FROM pg_roles WHERE rolname IN
       ('warehouse_readonly','warehouse_backend','warehouse_stock_executor')) THEN
    RAISE EXCEPTION 'Bootstrap refused: requires a fresh isolated PostgreSQL 17 cluster';
  END IF;
END
$guard$;

-- CREATE DATABASE cannot be in a transaction; partial bootstrap needs inspection.
CREATE DATABASE smart_warehouse_phase3_test OWNER postgres TEMPLATE template0 ENCODING 'UTF8';
BEGIN;
CREATE ROLE warehouse_readonly NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE warehouse_backend NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE warehouse_stock_executor NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
REVOKE ALL ON DATABASE smart_warehouse_phase3_test FROM PUBLIC;
GRANT CONNECT ON DATABASE smart_warehouse_phase3_test TO warehouse_readonly, warehouse_backend;
ALTER DATABASE smart_warehouse_phase3_test SET phase3.environment = 'isolated-test-v1';
ALTER ROLE warehouse_readonly IN DATABASE smart_warehouse_phase3_test SET default_transaction_read_only = on;
ALTER ROLE warehouse_backend IN DATABASE smart_warehouse_phase3_test SET default_transaction_read_only = off;
COMMIT;
-- No passwords, no LOGIN enabled. Reconnect to the named test DB for next files.
