\set ON_ERROR_STOP on
-- PROPOSED catalog-only assertion. No BEGIN/COMMIT/ROLLBACK or business call.
\ir guard-test.psql
DO $assert$
DECLARE
  v_oid oid := to_regprocedure('public.record_stock_movement(uuid,bigint,character varying,character varying,character varying,integer)');
  v_role text;
  v_cells bigint;
  v_bad bigint;
BEGIN
  IF (SELECT count(*) FROM pg_roles WHERE rolname IN ('warehouse_readonly','warehouse_backend','warehouse_stock_executor')) <> 3
     OR EXISTS (SELECT 1 FROM pg_roles WHERE rolname IN ('warehouse_readonly','warehouse_backend','warehouse_stock_executor')
       AND (rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls OR rolinherit
            OR (rolname='warehouse_stock_executor' AND rolcanlogin)))
     OR EXISTS (SELECT 1 FROM pg_auth_members m JOIN pg_roles a ON a.oid=m.member JOIN pg_roles b ON b.oid=m.roleid
       WHERE a.rolname IN ('warehouse_readonly','warehouse_backend','warehouse_stock_executor')
          OR b.rolname IN ('warehouse_readonly','warehouse_backend','warehouse_stock_executor')) THEN
    RAISE EXCEPTION 'Hardening assertion failed: roles or memberships';
  END IF;
  IF v_oid IS NULL OR NOT EXISTS (SELECT 1 FROM pg_proc p WHERE p.oid=v_oid
       AND p.prosecdef AND pg_get_userbyid(p.proowner)='warehouse_stock_executor'
       AND p.proconfig=ARRAY['search_path=pg_catalog, public, pg_temp']::text[])
     OR has_function_privilege('warehouse_readonly',v_oid,'EXECUTE')
     OR NOT has_function_privilege('warehouse_backend',v_oid,'EXECUTE')
     OR EXISTS (SELECT 1 FROM pg_proc p CROSS JOIN LATERAL aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) x
       WHERE p.oid=v_oid AND x.privilege_type='EXECUTE'
         AND (x.grantee NOT IN (p.proowner,(SELECT oid FROM pg_roles WHERE rolname='warehouse_backend'))
              OR (x.grantee=(SELECT oid FROM pg_roles WHERE rolname='warehouse_backend') AND x.is_grantable))) THEN
    RAISE EXCEPTION 'Hardening assertion failed: function owner, mode, path or EXECUTE';
  END IF;
  IF (SELECT array_agg(c.relname::text ORDER BY c.relname) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
      WHERE n.nspname='public' AND c.relkind IN ('r','p')) IS DISTINCT FROM
       ARRAY['inventory','product_units','products','scan_points','stock_transactions','users']::text[]
     OR EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
       WHERE n.nspname='public' AND c.relkind IN ('r','p')
         AND (pg_get_userbyid(c.relowner)<>'postgres' OR c.relrowsecurity OR c.relforcerowsecurity))
     OR NOT EXISTS (SELECT 1 FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum
       WHERE a.attrelid=to_regclass('public.stock_transactions') AND a.attname='request_scan_code'
         AND NOT a.attisdropped AND NOT a.attnotnull AND format_type(a.atttypid,a.atttypmod)='character varying(80)'
         AND d.oid IS NULL) THEN
    RAISE EXCEPTION 'Hardening assertion failed: tables or nullable request column';
  END IF;
WITH roles(role_name) AS (VALUES ('warehouse_readonly'),('warehouse_backend'),('warehouse_stock_executor')),
columns AS (
  SELECT c.oid,c.relname,a.attnum,a.attname FROM pg_class c
  JOIN pg_namespace n ON n.oid=c.relnamespace JOIN pg_attribute a ON a.attrelid=c.oid
  WHERE n.nspname='public' AND c.relkind IN ('r','p') AND a.attnum>0 AND NOT a.attisdropped
), expected AS (
  SELECT r.role_name,c.*,
    CASE r.role_name
      WHEN 'warehouse_readonly' THEN c.relname IN ('products','product_units','inventory','stock_transactions','scan_points')
      WHEN 'warehouse_backend' THEN
        (c.relname='users' AND c.attname IN ('user_id','username','display_name','role','password_hash','is_active')) OR
        (c.relname='stock_transactions' AND c.attname IN ('transaction_id','product_id','product_unit_id','scan_point_id',
          'movement_type','quantity_packages','conversion_factor_snapshot','quantity_base','inventory_after','created_at'))
      ELSE
        (c.relname='users' AND c.attname IN ('user_id','role','is_active')) OR
        (c.relname='products' AND c.attname IN ('product_id','is_active')) OR
        (c.relname='product_units' AND c.attname IN ('product_id','product_unit_id','scan_code','conversion_factor')) OR
        (c.relname='scan_points' AND c.attname IN ('scan_point_id','is_active')) OR
        (c.relname='inventory' AND c.attname IN ('product_id','quantity_base')) OR
        (c.relname='stock_transactions' AND c.attname IN
          ('transaction_id','user_id','scan_point_id','movement_type','quantity_packages','request_scan_code','inventory_after'))
    END AS expect_select,
    r.role_name='warehouse_stock_executor' AND c.relname='stock_transactions' AND c.attname IN
      ('transaction_id','product_id','product_unit_id','scan_point_id','user_id','movement_type','quantity_packages',
       'conversion_factor_snapshot','inventory_after','request_scan_code') AS expect_insert,
    r.role_name='warehouse_stock_executor' AND
      ((c.relname='inventory' AND c.attname IN ('quantity_base','updated_at')) OR
       (c.relname='stock_transactions' AND c.attname='inventory_after')) AS expect_update
  FROM roles r CROSS JOIN columns c
), checks AS (
  SELECT *,has_column_privilege(role_name,oid,attnum,'SELECT')=expect_select
    AND has_column_privilege(role_name,oid,attnum,'INSERT')=expect_insert
    AND has_column_privilege(role_name,oid,attnum,'UPDATE')=expect_update
    AND NOT has_column_privilege(role_name,oid,attnum,'REFERENCES')
    AND NOT has_column_privilege(role_name,oid,attnum,'SELECT WITH GRANT OPTION')
    AND NOT has_column_privilege(role_name,oid,attnum,'INSERT WITH GRANT OPTION')
    AND NOT has_column_privilege(role_name,oid,attnum,'UPDATE WITH GRANT OPTION') AS ok
  FROM expected
)
SELECT count(*),count(*) FILTER (WHERE ok IS NOT TRUE) INTO v_cells,v_bad FROM checks;
  -- 36 actual columns across six tables, checked for each of the three roles.
  IF v_cells<>108 OR v_bad<>0 THEN
    RAISE EXCEPTION 'Hardening assertion failed: effective column privileges';
  END IF;
  FOREACH v_role IN ARRAY ARRAY['warehouse_readonly','warehouse_backend','warehouse_stock_executor'] LOOP
    IF NOT has_schema_privilege(v_role,'public','USAGE')
       OR has_schema_privilege(v_role,'public','CREATE')
       OR has_database_privilege(v_role,current_database(),'CREATE,TEMP')
       OR has_database_privilege(v_role,current_database(),'CONNECT')<>(v_role<>'warehouse_stock_executor')
       OR EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
         WHERE n.nspname='public' AND c.relkind IN ('r','p')
           AND has_table_privilege(v_role,c.oid,'DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN'))
       OR EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
         WHERE n.nspname='public' AND CASE WHEN c.relkind='S'
           THEN has_sequence_privilege(v_role,c.oid,'USAGE,SELECT,UPDATE') ELSE false END) THEN
      RAISE EXCEPTION 'Hardening assertion failed: database, schema, table or sequence rights';
    END IF;
  END LOOP;
END;
$assert$;
