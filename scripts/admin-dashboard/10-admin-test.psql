\set ON_ERROR_STOP on
-- Admin Dashboard additions. TEST ONLY; production execution needs separate approval.
BEGIN;
\ir ../phase3/guard-test.psql
SET LOCAL lock_timeout='1s';
SET LOCAL statement_timeout='5s';
DO $guard$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_proc p JOIN pg_roles r ON r.oid=p.proowner
      WHERE p.oid=to_regprocedure('public.record_stock_movement(uuid,bigint,character varying,character varying,character varying,integer)')
        AND p.prosecdef AND r.rolname='warehouse_stock_executor' AND NOT (r.rolsuper OR r.rolcanlogin)
        AND p.proconfig=ARRAY['search_path=pg_catalog, public, pg_temp']::text[])
     OR has_function_privilege('warehouse_readonly',
       'public.record_stock_movement(uuid,bigint,character varying,character varying,character varying,integer)','EXECUTE') THEN
    RAISE EXCEPTION 'Hardened phase3 test baseline required';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='warehouse_admin_executor') THEN
    CREATE ROLE warehouse_admin_executor NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
  END IF;
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname='warehouse_admin_executor'
      AND (rolcanlogin OR rolinherit OR rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls))
     OR EXISTS (SELECT 1 FROM pg_auth_members WHERE member=(SELECT oid FROM pg_roles WHERE rolname='warehouse_admin_executor')
                OR roleid=(SELECT oid FROM pg_roles WHERE rolname='warehouse_admin_executor')) THEN
    RAISE EXCEPTION 'Admin executor must be restricted NOLOGIN without memberships';
  END IF;
END;
$guard$;

-- Existing users retain their credentials; only a nonsecret revocation counter is added.
ALTER TABLE public.users ADD COLUMN IF NOT EXISTS auth_version bigint NOT NULL DEFAULT 0;
DO $guard$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='public.users'::regclass
      AND attname='auth_version' AND atttypid='bigint'::regtype AND attnotnull AND NOT attisdropped) THEN
    RAISE EXCEPTION 'Unexpected users.auth_version definition';
  END IF;
END;
$guard$;

GRANT USAGE ON SCHEMA public TO warehouse_admin_executor;
GRANT SELECT(auth_version,created_at) ON public.users TO warehouse_backend;
GRANT SELECT(user_id,username,display_name,role,is_active,created_at,auth_version),
  INSERT(username,display_name,role,password_hash,is_active),
  UPDATE(username,display_name,role,password_hash,is_active,auth_version)
  ON public.users TO warehouse_admin_executor;
GRANT SELECT(product_id,product_name,base_unit,is_active,created_at),
  INSERT(product_id,product_name,base_unit,is_active),UPDATE(product_name,base_unit,is_active)
  ON public.products TO warehouse_admin_executor;
GRANT SELECT(product_unit_id,product_id,unit_name,conversion_factor,scan_code,is_base_unit),
  INSERT(product_id,unit_name,conversion_factor,scan_code,is_base_unit),UPDATE(unit_name)
  ON public.product_units TO warehouse_admin_executor;
GRANT SELECT(scan_point_id,point_name,is_active),INSERT(scan_point_id,point_name,is_active),
  UPDATE(point_name,is_active) ON public.scan_points TO warehouse_admin_executor;
GRANT SELECT(product_id,quantity_base),INSERT(product_id) ON public.inventory TO warehouse_admin_executor;
GRANT SELECT(product_id) ON public.stock_transactions TO warehouse_admin_executor;

CREATE OR REPLACE FUNCTION public.admin_dashboard_write(p_actor_id bigint,p_action text,p_payload jsonb)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY INVOKER
SET search_path=pg_catalog,public,pg_temp
AS $function$
DECLARE
  v_allowed text[];
  v_required text[];
  v_key text;
  v_value jsonb;
  v_id text;
  v_target_id bigint;
  v_product record;
  v_unit record;
  v_point record;
  v_user record;
  v_new_role text;
  v_new_active boolean;
BEGIN
  IF p_actor_id IS NULL OR p_action IS NULL OR jsonb_typeof(p_payload) IS DISTINCT FROM 'object' THEN
    RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='Invalid administrative request';
  END IF;
  CASE p_action
    WHEN 'product.create' THEN v_allowed:=ARRAY['product_id','product_name','base_unit','is_active']; v_required:=ARRAY['product_id','product_name','base_unit'];
    WHEN 'product.update' THEN v_allowed:=ARRAY['product_id','product_name','base_unit']; v_required:=ARRAY['product_id'];
    WHEN 'product.status' THEN v_allowed:=ARRAY['product_id','is_active']; v_required:=v_allowed;
    WHEN 'unit.create' THEN v_allowed:=ARRAY['product_id','unit_name','conversion_factor','scan_code','is_base_unit']; v_required:=ARRAY['product_id','unit_name','conversion_factor','scan_code'];
    WHEN 'unit.update' THEN v_allowed:=ARRAY['product_unit_id','unit_name','conversion_factor','is_base_unit']; v_required:=ARRAY['product_unit_id'];
    WHEN 'scan-point.create' THEN v_allowed:=ARRAY['scan_point_id','point_name','is_active']; v_required:=ARRAY['scan_point_id','point_name'];
    WHEN 'scan-point.update' THEN v_allowed:=ARRAY['scan_point_id','point_name','is_active']; v_required:=ARRAY['scan_point_id'];
    WHEN 'user.create' THEN v_allowed:=ARRAY['username','display_name','role','password_hash','is_active']; v_required:=ARRAY['username','display_name','role','password_hash'];
    WHEN 'user.update' THEN v_allowed:=ARRAY['user_id','username','display_name','role']; v_required:=ARRAY['user_id'];
    WHEN 'user.status' THEN v_allowed:=ARRAY['user_id','is_active']; v_required:=v_allowed;
    WHEN 'user.reset-password' THEN v_allowed:=ARRAY['user_id','password_hash']; v_required:=v_allowed;
    ELSE RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='Unsupported administrative operation';
  END CASE;
  IF NOT p_payload ?& v_required OR EXISTS (SELECT 1 FROM jsonb_object_keys(p_payload) AS keys(key_name) WHERE NOT key_name=ANY(v_allowed)) THEN
    RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='Invalid administrative fields';
  END IF;
  IF p_action IN ('product.update','unit.update','scan-point.update','user.update')
      AND (SELECT count(*) FROM jsonb_object_keys(p_payload))<2 THEN
    RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='At least one editable field is required';
  END IF;
  FOR v_key,v_value IN SELECT key,value FROM jsonb_each(p_payload) LOOP
    IF v_key IN ('is_active','is_base_unit') THEN
      IF jsonb_typeof(v_value)<>'boolean' THEN RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='Invalid boolean'; END IF;
    ELSIF v_key='conversion_factor' THEN
      IF jsonb_typeof(v_value)<>'number' OR (v_value::text)!~'^[1-9][0-9]*$'
         OR (v_value::text)::numeric>2147483647 THEN
        RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='Invalid conversion factor';
      END IF;
    ELSE
      IF jsonb_typeof(v_value)<>'string' OR length(btrim(p_payload->>v_key))=0
         OR p_payload->>v_key<>btrim(p_payload->>v_key) THEN
        RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='Invalid text field';
      END IF;
      IF length(p_payload->>v_key)>(CASE v_key WHEN 'product_id' THEN 20 WHEN 'scan_point_id' THEN 20
          WHEN 'product_name' THEN 150 WHEN 'base_unit' THEN 30 WHEN 'unit_name' THEN 30
          WHEN 'scan_code' THEN 80 WHEN 'point_name' THEN 100 WHEN 'username' THEN 50
          WHEN 'display_name' THEN 120 WHEN 'role' THEN 20 WHEN 'password_hash' THEN 512 ELSE 19 END) THEN
        RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='Text field too long';
      END IF;
    END IF;
  END LOOP;
  IF p_payload ? 'role' AND p_payload->>'role' NOT IN ('ADMIN','KEEPER','STAFF','VIEWER') THEN
    RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='Invalid application role';
  END IF;
  IF p_payload ? 'password_hash' AND (p_payload->>'password_hash')!~
      '^\$argon2id\$v=19\$m=[0-9]+,t=[0-9]+,p=[0-9]+\$[A-Za-z0-9+/]+=*\$[A-Za-z0-9+/]+=*$' THEN
    RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='Unsupported password encoding';
  END IF;
  IF p_action LIKE 'user.%' THEN
    -- All account mutations share one transaction lock: no two last-admin checks race.
    PERFORM pg_catalog.pg_advisory_xact_lock(724901,1);
  END IF;
  IF NOT EXISTS (SELECT 1 FROM public.users u WHERE u.user_id=p_actor_id AND u.is_active AND u.role='ADMIN') THEN
    RAISE EXCEPTION USING ERRCODE='PZA04',MESSAGE='Administrative access required';
  END IF;

  IF p_action='product.create' THEN
    INSERT INTO public.products(product_id,product_name,base_unit,is_active)
      VALUES(p_payload->>'product_id',p_payload->>'product_name',p_payload->>'base_unit',coalesce((p_payload->>'is_active')::boolean,true))
      RETURNING product_id,product_name,base_unit,is_active,created_at INTO v_product;
  ELSIF p_action IN ('product.update','product.status') THEN
    SELECT p.product_id,p.product_name,p.base_unit,p.is_active,p.created_at INTO v_product
      FROM public.products p WHERE p.product_id=p_payload->>'product_id' FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='PZA02',MESSAGE='Product not found'; END IF;
    IF p_payload ? 'base_unit' AND p_payload->>'base_unit'<>v_product.base_unit
       AND (EXISTS(SELECT 1 FROM public.product_units pu WHERE pu.product_id=v_product.product_id)
         OR EXISTS(SELECT 1 FROM public.stock_transactions t WHERE t.product_id=v_product.product_id)
         OR EXISTS(SELECT 1 FROM public.inventory i WHERE i.product_id=v_product.product_id AND i.quantity_base<>0)) THEN
      RAISE EXCEPTION USING ERRCODE='PZA06',MESSAGE='Base unit is already in use';
    END IF;
    UPDATE public.products SET product_name=coalesce(p_payload->>'product_name',v_product.product_name),
      base_unit=coalesce(p_payload->>'base_unit',v_product.base_unit),is_active=coalesce((p_payload->>'is_active')::boolean,v_product.is_active)
      WHERE product_id=v_product.product_id RETURNING product_id,product_name,base_unit,is_active,created_at INTO v_product;
  ELSIF p_action='unit.create' THEN
    PERFORM 1 FROM public.products p WHERE p.product_id=p_payload->>'product_id' FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='PZA02',MESSAGE='Product not found'; END IF;
    IF coalesce((p_payload->>'is_base_unit')::boolean,false) AND (p_payload->>'conversion_factor')::integer<>1 THEN
      RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='A base unit must have factor one';
    END IF;
    INSERT INTO public.product_units(product_id,unit_name,conversion_factor,scan_code,is_base_unit)
      VALUES(p_payload->>'product_id',p_payload->>'unit_name',(p_payload->>'conversion_factor')::integer,
        p_payload->>'scan_code',coalesce((p_payload->>'is_base_unit')::boolean,false))
      RETURNING product_unit_id,product_id,unit_name,conversion_factor,scan_code,is_base_unit INTO v_unit;
  ELSIF p_action='unit.update' THEN
    IF (p_payload->>'product_unit_id')!~'^[1-9][0-9]*$' THEN RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='Invalid unit ID'; END IF;
    SELECT pu.product_unit_id,pu.product_id,pu.unit_name,pu.conversion_factor,pu.scan_code,pu.is_base_unit INTO v_unit
      FROM public.product_units pu WHERE pu.product_unit_id=(p_payload->>'product_unit_id')::bigint FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='PZA02',MESSAGE='Product unit not found'; END IF;
    IF (p_payload ? 'conversion_factor' AND (p_payload->>'conversion_factor')::integer<>v_unit.conversion_factor)
       OR (p_payload ? 'is_base_unit' AND (p_payload->>'is_base_unit')::boolean<>v_unit.is_base_unit) THEN
      RAISE EXCEPTION USING ERRCODE='PZA06',MESSAGE='Create a new unit and scan code to change conversion';
    END IF;
    UPDATE public.product_units SET unit_name=coalesce(p_payload->>'unit_name',v_unit.unit_name)
      WHERE product_unit_id=v_unit.product_unit_id
      RETURNING product_unit_id,product_id,unit_name,conversion_factor,scan_code,is_base_unit INTO v_unit;
  ELSIF p_action IN ('scan-point.create','scan-point.update') THEN
    IF p_action='scan-point.create' THEN
      INSERT INTO public.scan_points(scan_point_id,point_name,is_active)
        VALUES(p_payload->>'scan_point_id',p_payload->>'point_name',coalesce((p_payload->>'is_active')::boolean,true))
        RETURNING scan_point_id,point_name,is_active INTO v_point;
    ELSE
      SELECT s.scan_point_id,s.point_name,s.is_active INTO v_point FROM public.scan_points s
        WHERE s.scan_point_id=p_payload->>'scan_point_id' FOR UPDATE;
      IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='PZA02',MESSAGE='Scan point not found'; END IF;
      UPDATE public.scan_points SET point_name=coalesce(p_payload->>'point_name',v_point.point_name),
        is_active=coalesce((p_payload->>'is_active')::boolean,v_point.is_active) WHERE scan_point_id=v_point.scan_point_id
        RETURNING scan_point_id,point_name,is_active INTO v_point;
    END IF;
  ELSIF p_action='user.create' THEN
    INSERT INTO public.users(username,display_name,role,password_hash,is_active)
      VALUES(p_payload->>'username',p_payload->>'display_name',p_payload->>'role',p_payload->>'password_hash',coalesce((p_payload->>'is_active')::boolean,true))
      RETURNING user_id,username,display_name,role,is_active,created_at INTO v_user;
  ELSE
    IF (p_payload->>'user_id')!~'^[1-9][0-9]*$' THEN RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='Invalid user ID'; END IF;
    v_target_id:=(p_payload->>'user_id')::bigint;
    SELECT u.user_id,u.username,u.display_name,u.role,u.is_active,u.created_at INTO v_user FROM public.users u
      WHERE u.user_id=v_target_id FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='PZA02',MESSAGE='User not found'; END IF;
    v_new_role:=coalesce(p_payload->>'role',v_user.role);
    v_new_active:=coalesce((p_payload->>'is_active')::boolean,v_user.is_active);
    IF v_user.role='ADMIN' AND v_user.is_active AND (v_new_role<>'ADMIN' OR NOT v_new_active)
       AND (SELECT count(*) FROM public.users u WHERE u.role='ADMIN' AND u.is_active)<=1 THEN
      RAISE EXCEPTION USING ERRCODE='PZA05',MESSAGE='The last active admin must remain active';
    END IF;
    IF p_action='user.reset-password' THEN
      UPDATE public.users SET password_hash=p_payload->>'password_hash',auth_version=auth_version+1 WHERE user_id=v_target_id;
    ELSE
      UPDATE public.users SET username=coalesce(p_payload->>'username',v_user.username),
        display_name=coalesce(p_payload->>'display_name',v_user.display_name),role=v_new_role,is_active=v_new_active,
        auth_version=auth_version+CASE WHEN role IS DISTINCT FROM v_new_role OR is_active IS DISTINCT FROM v_new_active THEN 1 ELSE 0 END
        WHERE user_id=v_target_id;
    END IF;
    SELECT u.user_id,u.username,u.display_name,u.role,u.is_active,u.created_at INTO v_user FROM public.users u WHERE u.user_id=v_target_id;
  END IF;
  IF p_action LIKE 'product.%' THEN
    RETURN jsonb_build_object('product_id',v_product.product_id,'product_name',v_product.product_name,
      'base_unit',v_product.base_unit,'is_active',v_product.is_active,'created_at',v_product.created_at);
  ELSIF p_action LIKE 'unit.%' THEN
    RETURN jsonb_build_object('product_unit_id',v_unit.product_unit_id::text,'product_id',v_unit.product_id,
      'unit_name',v_unit.unit_name,'conversion_factor',v_unit.conversion_factor,'scan_code',v_unit.scan_code,'is_base_unit',v_unit.is_base_unit);
  ELSIF p_action LIKE 'scan-point.%' THEN
    RETURN jsonb_build_object('scan_point_id',v_point.scan_point_id,'point_name',v_point.point_name,'is_active',v_point.is_active);
  END IF;
  RETURN jsonb_build_object('user_id',v_user.user_id::text,'username',v_user.username,'display_name',v_user.display_name,
    'role',v_user.role,'is_active',v_user.is_active,'created_at',v_user.created_at);
EXCEPTION
  WHEN unique_violation THEN RAISE EXCEPTION USING ERRCODE='PZA03',MESSAGE='Resource already exists';
  WHEN check_violation OR invalid_text_representation OR numeric_value_out_of_range OR not_null_violation THEN
    RAISE EXCEPTION USING ERRCODE='PZA01',MESSAGE='Invalid administrative request';
END;
$function$;

REVOKE ALL ON FUNCTION public.admin_dashboard_write(bigint,text,jsonb) FROM PUBLIC,warehouse_readonly,warehouse_backend;
ALTER FUNCTION public.admin_dashboard_write(bigint,text,jsonb) OWNER TO warehouse_admin_executor;
DO $owner$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_proc p JOIN pg_roles r ON r.oid=p.proowner
      WHERE p.oid='public.admin_dashboard_write(bigint,text,jsonb)'::regprocedure
      AND NOT p.prosecdef AND r.rolname='warehouse_admin_executor' AND NOT r.rolcanlogin AND NOT r.rolsuper) THEN
    RAISE EXCEPTION 'Restricted owner required before SECURITY DEFINER';
  END IF;
END;
$owner$;
ALTER FUNCTION public.admin_dashboard_write(bigint,text,jsonb) SECURITY DEFINER;
GRANT EXECUTE ON FUNCTION public.admin_dashboard_write(bigint,text,jsonb) TO warehouse_backend;
DO $postcheck$
BEGIN
  IF has_function_privilege('warehouse_readonly','public.admin_dashboard_write(bigint,text,jsonb)','EXECUTE')
     OR has_column_privilege('warehouse_admin_executor','public.users','password_hash','SELECT')
     OR has_any_column_privilege('warehouse_admin_executor','public.inventory','UPDATE')
     OR has_any_column_privilege('warehouse_backend','public.users','INSERT,UPDATE,REFERENCES')
     OR has_any_column_privilege('warehouse_backend','public.products','INSERT,UPDATE,REFERENCES') THEN
    RAISE EXCEPTION 'Unexpected effective administrative privilege';
  END IF;
END;
$postcheck$;
COMMIT;
