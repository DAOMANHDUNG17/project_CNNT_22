\set ON_ERROR_STOP on
\ir review-gate.psql
ALTER TABLE public.users
 ADD COLUMN auth_user_id uuid UNIQUE REFERENCES auth.users(id) ON DELETE NO ACTION,
 ADD COLUMN auth_state text NOT NULL DEFAULT 'PENDING' CHECK (auth_state IN ('PENDING','READY','BLOCKED')),
 ADD COLUMN auth_reauth_after timestamptz NOT NULL DEFAULT '-infinity',
 ADD CONSTRAINT ck_ready_auth_mapping CHECK (auth_state<>'READY' OR auth_user_id IS NOT NULL);
-- No automatic linking, backfill, email matching or replacement of bigint history.
CREATE TABLE public.warehouse_auth_sessions (
 session_id uuid PRIMARY KEY,
 user_id bigint NOT NULL REFERENCES public.users(user_id),
 auth_version bigint NOT NULL,
 issued_at timestamptz NOT NULL,
 last_seen_at timestamptz NOT NULL,
 expires_at timestamptz NOT NULL,
 revoked_at timestamptz,
 CHECK (expires_at>issued_at), CHECK (last_seen_at>=issued_at)
);
CREATE INDEX warehouse_auth_sessions_expiry ON public.warehouse_auth_sessions(expires_at);
CREATE INDEX warehouse_auth_sessions_user ON public.warehouse_auth_sessions(user_id);
CREATE TABLE public.warehouse_rate_buckets (
 policy text NOT NULL CHECK (policy IN ('api-ip','api-user')),
 bucket text NOT NULL CHECK (bucket ~ '^[0-9a-f]{64}$'),
 window_start timestamptz NOT NULL,
 requests integer NOT NULL CHECK (requests BETWEEN 1 AND 241),
 expires_at timestamptz NOT NULL,
 PRIMARY KEY(policy,bucket), CHECK (expires_at>window_start)
);
CREATE INDEX warehouse_rate_buckets_expiry ON public.warehouse_rate_buckets(expires_at);
CREATE FUNCTION public.advance_cloud_auth_cutoff() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog,public,pg_temp
AS $function$
BEGIN
 IF NEW.auth_version IS DISTINCT FROM OLD.auth_version OR NEW.auth_user_id IS DISTINCT FROM OLD.auth_user_id
    OR NEW.auth_state IS DISTINCT FROM OLD.auth_state THEN
   NEW.auth_reauth_after := greatest(clock_timestamp(),OLD.auth_reauth_after);
 END IF;
 RETURN NEW;
END
$function$;
REVOKE ALL ON FUNCTION public.advance_cloud_auth_cutoff() FROM PUBLIC,anon,authenticated,service_role;
CREATE TRIGGER trg_cloud_auth_cutoff BEFORE UPDATE ON public.users
FOR EACH ROW EXECUTE FUNCTION public.advance_cloud_auth_cutoff();
