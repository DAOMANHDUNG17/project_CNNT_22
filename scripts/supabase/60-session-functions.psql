\set ON_ERROR_STOP on
\ir review-gate.psql
-- REVIEW CANDIDATE ONLY. D8 bridge must exist; no custom role access to auth schema.
-- No writes/triggers/locks in managed auth schema. See 55-provider-contract.md.
CREATE FUNCTION public.resolve_cloud_principal(p_subject uuid,p_session uuid)
RETURNS TABLE(user_id text,username text,display_name text,role text,is_active boolean,auth_version text)
LANGUAGE plpgsql VOLATILE SECURITY INVOKER SET search_path=pg_catalog,public,pg_temp
AS $function$
DECLARE
 v_user record;
 v_provider record;
 v_session public.warehouse_auth_sessions%ROWTYPE;
 v_now timestamptz;
BEGIN
 SELECT u.user_id,u.username,u.display_name,u.role,u.is_active,u.auth_version,u.auth_reauth_after
 INTO v_user FROM public.users u WHERE u.auth_user_id=p_subject AND u.auth_state='READY' AND u.is_active;
 IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='PZS01',MESSAGE='Authentication required'; END IF;
 SELECT s.created_at,s.not_after INTO v_provider FROM warehouse_private.provider_session_window(p_subject,p_session) s;
 v_now:=clock_timestamp();
 IF NOT FOUND OR v_provider.created_at IS NULL OR v_provider.created_at>v_now
    OR v_provider.created_at<=v_user.auth_reauth_after OR v_provider.created_at+interval '8 hours'<=v_now
    OR v_provider.not_after<=v_now THEN
   RAISE EXCEPTION USING ERRCODE='PZS01',MESSAGE='Authentication required';
 END IF;
 IF NOT EXISTS(SELECT 1 FROM public.warehouse_auth_sessions s WHERE s.session_id=p_session) THEN
   -- Serialize admissions to enforce a bounded store across all backend processes.
   PERFORM pg_advisory_xact_lock(724902,1);
   DELETE FROM public.warehouse_auth_sessions s WHERE s.session_id IN
     (SELECT x.session_id FROM public.warehouse_auth_sessions x WHERE x.expires_at<=v_now ORDER BY x.expires_at LIMIT 200);
   IF (SELECT count(*) FROM public.warehouse_auth_sessions)>=10000 THEN
     RAISE EXCEPTION USING ERRCODE='PZS02',MESSAGE='Session capacity unavailable';
   END IF;
   INSERT INTO public.warehouse_auth_sessions(session_id,user_id,auth_version,issued_at,last_seen_at,expires_at)
     VALUES(p_session,v_user.user_id,v_user.auth_version,v_provider.created_at,v_now,v_provider.created_at+interval '8 hours')
     ON CONFLICT(session_id) DO NOTHING;
 END IF;
 SELECT s.* INTO v_session FROM public.warehouse_auth_sessions s WHERE s.session_id=p_session FOR UPDATE;
 v_now:=clock_timestamp();
 IF NOT FOUND OR v_session.user_id<>v_user.user_id OR v_session.auth_version<>v_user.auth_version
    OR v_session.issued_at<>v_provider.created_at OR v_session.revoked_at IS NOT NULL
    OR v_session.last_seen_at>v_now OR v_session.last_seen_at+interval '30 minutes'<=v_now
    OR v_session.expires_at<=v_now OR v_provider.not_after<=v_now THEN
   RAISE EXCEPTION USING ERRCODE='PZS01',MESSAGE='Authentication required';
 END IF;
 -- Never delete idle-expired/revoked rows before absolute expiry: that would readmit an old JWT.
 UPDATE public.warehouse_auth_sessions s SET last_seen_at=v_now WHERE s.session_id=p_session;
 RETURN QUERY SELECT v_user.user_id::text,v_user.username::text,v_user.display_name::text,v_user.role::text,true,v_user.auth_version::text;
END
$function$;

CREATE FUNCTION public.revoke_cloud_session(p_session uuid,p_user bigint) RETURNS void
LANGUAGE plpgsql VOLATILE SECURITY INVOKER SET search_path=pg_catalog,public,pg_temp
AS $function$
BEGIN
 UPDATE public.warehouse_auth_sessions s SET revoked_at=coalesce(s.revoked_at,clock_timestamp())
 WHERE s.session_id=p_session AND s.user_id=p_user;
 IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='PZS01',MESSAGE='Authentication required'; END IF;
END
$function$;

CREATE FUNCTION public.rate_cloud_request(p_policy text,p_bucket text)
RETURNS TABLE(allowed boolean,retry_after integer)
LANGUAGE plpgsql VOLATILE SECURITY INVOKER SET search_path=pg_catalog,public,pg_temp
AS $function$
DECLARE v_limit integer; v_now timestamptz; v_row public.warehouse_rate_buckets%ROWTYPE;
BEGIN
 IF p_policy IS NULL OR p_policy NOT IN ('api-ip','api-user') OR p_bucket IS NULL OR p_bucket !~ '^[0-9a-f]{64}$' THEN
   RAISE EXCEPTION USING ERRCODE='PZS02',MESSAGE='Invalid limiter request';
 END IF;
 v_limit:=CASE p_policy WHEN 'api-ip' THEN 120 ELSE 240 END;
 v_now:=clock_timestamp();
 IF NOT EXISTS(SELECT 1 FROM public.warehouse_rate_buckets b WHERE b.policy=p_policy AND b.bucket=p_bucket) THEN
   PERFORM pg_advisory_xact_lock(724902,2);
   DELETE FROM public.warehouse_rate_buckets b WHERE (b.policy,b.bucket) IN
    (SELECT x.policy,x.bucket FROM public.warehouse_rate_buckets x WHERE x.expires_at<=v_now ORDER BY x.expires_at LIMIT 200);
   IF (SELECT count(*) FROM public.warehouse_rate_buckets)>=20000 THEN
     RAISE EXCEPTION USING ERRCODE='PZS02',MESSAGE='Limiter capacity unavailable';
   END IF;
   INSERT INTO public.warehouse_rate_buckets(policy,bucket,window_start,requests,expires_at)
    VALUES(p_policy,p_bucket,v_now,1,v_now+interval '60 seconds') ON CONFLICT(policy,bucket) DO NOTHING;
   IF FOUND THEN RETURN QUERY SELECT true,0; RETURN; END IF;
 END IF;
 SELECT b.* INTO v_row FROM public.warehouse_rate_buckets b WHERE b.policy=p_policy AND b.bucket=p_bucket FOR UPDATE;
 v_now:=clock_timestamp();
 IF NOT FOUND OR v_row.window_start>v_now THEN RAISE EXCEPTION USING ERRCODE='PZS02',MESSAGE='Limiter state unavailable'; END IF;
 IF v_row.expires_at<=v_now THEN
   UPDATE public.warehouse_rate_buckets b SET window_start=v_now,requests=1,expires_at=v_now+interval '60 seconds'
    WHERE b.policy=p_policy AND b.bucket=p_bucket;
   RETURN QUERY SELECT true,0;
 ELSE
   UPDATE public.warehouse_rate_buckets b SET requests=least(v_limit+1,b.requests+1) WHERE b.policy=p_policy AND b.bucket=p_bucket;
   RETURN QUERY SELECT v_row.requests<v_limit,greatest(1,least(60,ceil(extract(epoch FROM v_row.expires_at-v_now))::integer));
 END IF;
END
$function$;

REVOKE ALL ON FUNCTION public.resolve_cloud_principal(uuid,uuid),public.revoke_cloud_session(uuid,bigint),public.rate_cloud_request(text,text)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT warehouse_auth_executor TO postgres WITH INHERIT FALSE, SET TRUE;
GRANT CREATE ON SCHEMA public TO warehouse_auth_executor;
ALTER FUNCTION public.resolve_cloud_principal(uuid,uuid) OWNER TO warehouse_auth_executor;
ALTER FUNCTION public.revoke_cloud_session(uuid,bigint) OWNER TO warehouse_auth_executor;
ALTER FUNCTION public.rate_cloud_request(text,text) OWNER TO warehouse_auth_executor;
SET LOCAL ROLE warehouse_auth_executor;
ALTER FUNCTION public.resolve_cloud_principal(uuid,uuid) SECURITY DEFINER;
ALTER FUNCTION public.revoke_cloud_session(uuid,bigint) SECURITY DEFINER;
ALTER FUNCTION public.rate_cloud_request(text,text) SECURITY DEFINER;
GRANT EXECUTE ON FUNCTION public.resolve_cloud_principal(uuid,uuid),public.revoke_cloud_session(uuid,bigint),public.rate_cloud_request(text,text) TO warehouse_backend;
RESET ROLE;
