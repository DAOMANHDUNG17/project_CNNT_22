\set ON_ERROR_STOP on
\ir review-gate.psql
-- Include in ONE reviewed migration transaction; never run standalone.
-- Extracted function definition only from scripts/phase3/40-hardening-test.psql
-- Source definition SHA256: 85526b9726b616b25aadd969928e253814b074b843557d472cc87b609934c1d1
CREATE OR REPLACE FUNCTION public.record_stock_movement(
  p_transaction_id uuid,p_user_id bigint,p_scan_point_id varchar,
  p_scan_code varchar,p_movement_type varchar,p_quantity_packages integer
) RETURNS TABLE(result_status text,current_inventory bigint)
-- Keep INVOKER until the non-superuser owner has been assigned and checked.
LANGUAGE plpgsql VOLATILE SECURITY INVOKER
SET search_path=pg_catalog,public,pg_temp
AS $function$
DECLARE
  v_role varchar(20);
  v_product_id varchar(20);
  v_product_active boolean;
  v_unit_id bigint;
  v_factor integer;
  v_base bigint;
  v_delta bigint;
  v_current bigint;
  v_inserted uuid;
  v_prior record;
BEGIN
  IF p_transaction_id IS NULL OR p_transaction_id::text !~
      '^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
     OR p_user_id IS NULL OR p_scan_point_id IS NULL OR p_scan_code IS NULL
     OR char_length(p_scan_point_id) NOT BETWEEN 1 AND 20
     OR char_length(p_scan_code) NOT BETWEEN 1 AND 80
     OR p_scan_point_id <> btrim(p_scan_point_id) OR p_scan_code <> btrim(p_scan_code)
     OR p_movement_type IS NULL OR p_movement_type NOT IN ('IN','OUT')
     OR p_quantity_packages IS NULL OR p_quantity_packages <= 0 THEN
    RAISE EXCEPTION USING ERRCODE='PZ001',MESSAGE='Invalid movement input';
  END IF;

  -- Advisory lock scopes one UUID, not the whole warehouse. PK remains mandatory.
  PERFORM pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended(p_transaction_id::text,0));
  SELECT u.role INTO v_role FROM public.users u WHERE u.user_id=p_user_id AND u.is_active;
  IF v_role IS NULL THEN
    RAISE EXCEPTION USING ERRCODE='PZ002',MESSAGE='Invalid or inactive actor';
  END IF;
  IF NOT (v_role IN ('ADMIN','KEEPER') OR (v_role='STAFF' AND p_movement_type='OUT')) THEN
    RAISE EXCEPTION USING ERRCODE='PZ003',MESSAGE='Movement not permitted';
  END IF;

  SELECT t.user_id,t.scan_point_id,t.movement_type,t.quantity_packages,t.request_scan_code,t.inventory_after
    INTO v_prior FROM public.stock_transactions t WHERE t.transaction_id=p_transaction_id;
  IF FOUND THEN
    IF v_prior.user_id IS DISTINCT FROM p_user_id THEN
      RAISE EXCEPTION USING ERRCODE='PZ004',MESSAGE='Idempotency conflict';
    END IF;
    IF v_prior.request_scan_code IS NULL THEN
      RAISE EXCEPTION USING ERRCODE='PZ005',MESSAGE='Legacy request cannot be replayed';
    END IF;
    IF v_prior.scan_point_id IS NOT DISTINCT FROM p_scan_point_id
       AND v_prior.movement_type IS NOT DISTINCT FROM p_movement_type
       AND v_prior.quantity_packages IS NOT DISTINCT FROM p_quantity_packages
       AND v_prior.request_scan_code IS NOT DISTINCT FROM p_scan_code THEN
      RETURN QUERY SELECT 'DUPLICATE'::text,v_prior.inventory_after::bigint;
      RETURN;
    END IF;
    RAISE EXCEPTION USING ERRCODE='PZ004',MESSAGE='Idempotency conflict';
  END IF;

  IF NOT EXISTS (SELECT 1 FROM public.scan_points s WHERE s.scan_point_id=p_scan_point_id AND s.is_active) THEN
    RAISE EXCEPTION USING ERRCODE='PZ006',MESSAGE='Invalid scan point';
  END IF;
  SELECT pu.product_id,pu.product_unit_id,pu.conversion_factor,p.is_active
    INTO v_product_id,v_unit_id,v_factor,v_product_active
    FROM public.product_units pu JOIN public.products p ON p.product_id=pu.product_id
    WHERE pu.scan_code=p_scan_code;
  IF NOT FOUND THEN
    RAISE EXCEPTION USING ERRCODE='PZ007',MESSAGE='Invalid scan code';
  END IF;
  IF NOT v_product_active THEN
    RAISE EXCEPTION USING ERRCODE='PZ008',MESSAGE='Inactive product';
  END IF;
  v_base := p_quantity_packages::bigint * v_factor::bigint;
  v_delta := CASE WHEN p_movement_type='IN' THEN v_base ELSE -v_base END;
  SELECT i.quantity_base INTO v_current FROM public.inventory i
    WHERE i.product_id=v_product_id FOR UPDATE;
  IF NOT FOUND THEN
    RAISE EXCEPTION USING ERRCODE='PZ009',MESSAGE='Invalid inventory state';
  END IF;

  INSERT INTO public.stock_transactions(transaction_id,product_id,product_unit_id,scan_point_id,user_id,
    movement_type,quantity_packages,conversion_factor_snapshot,inventory_after,request_scan_code)
  VALUES(p_transaction_id,v_product_id,v_unit_id,p_scan_point_id,p_user_id,p_movement_type,
    p_quantity_packages,v_factor,v_current,p_scan_code)
  ON CONFLICT(transaction_id) DO NOTHING RETURNING transaction_id INTO v_inserted;
  IF v_inserted IS NULL THEN
    -- Defensive fallback for a caller that did not use the advisory-lock protocol.
    SELECT t.user_id,t.scan_point_id,t.movement_type,t.quantity_packages,t.request_scan_code,t.inventory_after
      INTO v_prior FROM public.stock_transactions t WHERE t.transaction_id=p_transaction_id;
    IF NOT FOUND THEN
      RAISE EXCEPTION USING ERRCODE='40001',MESSAGE='Retry movement transaction';
    END IF;
    IF v_prior.user_id IS DISTINCT FROM p_user_id THEN
      RAISE EXCEPTION USING ERRCODE='PZ004',MESSAGE='Idempotency conflict';
    END IF;
    IF v_prior.request_scan_code IS NULL THEN
      RAISE EXCEPTION USING ERRCODE='PZ005',MESSAGE='Legacy request cannot be replayed';
    END IF;
    IF v_prior.scan_point_id IS NOT DISTINCT FROM p_scan_point_id
       AND v_prior.movement_type IS NOT DISTINCT FROM p_movement_type
       AND v_prior.quantity_packages IS NOT DISTINCT FROM p_quantity_packages
       AND v_prior.request_scan_code IS NOT DISTINCT FROM p_scan_code THEN
      RETURN QUERY SELECT 'DUPLICATE'::text,v_prior.inventory_after::bigint;
      RETURN;
    END IF;
    RAISE EXCEPTION USING ERRCODE='PZ004',MESSAGE='Idempotency conflict';
  END IF;
  IF p_movement_type='OUT' AND v_current < v_base THEN
    RAISE EXCEPTION USING ERRCODE='PZ010',MESSAGE='Insufficient inventory';
  END IF;
  IF p_movement_type='IN' AND v_current > 9223372036854775807::bigint-v_base THEN
    RAISE EXCEPTION USING ERRCODE='PZ011',MESSAGE='Stock limit exceeded';
  END IF;
  UPDATE public.inventory i SET quantity_base=i.quantity_base+v_delta,updated_at=now()
    WHERE i.product_id=v_product_id AND i.quantity_base+v_delta>=0
    RETURNING i.quantity_base INTO v_current;
  IF NOT FOUND THEN
    RAISE EXCEPTION USING ERRCODE='PZ010',MESSAGE='Insufficient inventory';
  END IF;
  UPDATE public.stock_transactions t SET inventory_after=v_current WHERE t.transaction_id=p_transaction_id;
  IF NOT FOUND THEN
    RAISE EXCEPTION USING ERRCODE='PZ009',MESSAGE='Invalid inventory state';
  END IF;
  RETURN QUERY SELECT 'CREATED'::text,v_current;
END
$function$;
REVOKE ALL ON FUNCTION public.record_stock_movement(uuid,bigint,varchar,varchar,varchar,integer) FROM PUBLIC,anon,authenticated,service_role;
-- Temporary ownership capability, removed in 70-grants.psql before COMMIT.
GRANT warehouse_stock_executor TO postgres WITH INHERIT FALSE, SET TRUE;
GRANT CREATE ON SCHEMA public TO warehouse_stock_executor;
ALTER FUNCTION public.record_stock_movement(uuid,bigint,varchar,varchar,varchar,integer) OWNER TO warehouse_stock_executor;
SET LOCAL ROLE warehouse_stock_executor;
ALTER FUNCTION public.record_stock_movement(uuid,bigint,varchar,varchar,varchar,integer) SECURITY DEFINER;
GRANT EXECUTE ON FUNCTION public.record_stock_movement(uuid,bigint,varchar,varchar,varchar,integer) TO warehouse_backend;
RESET ROLE;
