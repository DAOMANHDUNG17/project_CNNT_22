\set ON_ERROR_STOP on
\ir review-gate.psql
BEGIN;
-- Only after incident approval and confirmation of the exact Cloud target.
ALTER ROLE warehouse_backend NOLOGIN;
ALTER ROLE warehouse_readonly NOLOGIN;
GRANT warehouse_stock_executor,warehouse_admin_executor,warehouse_auth_executor TO postgres WITH INHERIT FALSE, SET TRUE;
SET LOCAL ROLE warehouse_stock_executor;
REVOKE EXECUTE ON FUNCTION public.record_stock_movement(uuid,bigint,varchar,varchar,varchar,integer) FROM warehouse_backend;
RESET ROLE;
SET LOCAL ROLE warehouse_admin_executor;
REVOKE EXECUTE ON FUNCTION public.admin_dashboard_write(bigint,text,jsonb) FROM warehouse_backend;
RESET ROLE;
SET LOCAL ROLE warehouse_auth_executor;
REVOKE EXECUTE ON FUNCTION public.resolve_cloud_principal(uuid,uuid),public.revoke_cloud_session(uuid,bigint),public.rate_cloud_request(text,text) FROM warehouse_backend;
RESET ROLE;
REVOKE warehouse_stock_executor,warehouse_admin_executor,warehouse_auth_executor FROM postgres GRANTED BY postgres;
COMMIT;
-- NOLOGIN does not disconnect existing sessions. Operator must stop all four backends,
-- identify exact warehouse runtime PIDs and terminate them through an approved incident procedure.
-- Do not DROP roles/tables, truncate history or roll back by resetting the cluster.
