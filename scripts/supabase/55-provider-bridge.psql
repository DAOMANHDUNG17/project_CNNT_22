\set ON_ERROR_STOP on
\ir review-gate.psql
-- D8 approved for source implementation only. No migration has been authorized/run.
-- The caller cannot change this schema/function. No managed Auth object is altered.
CREATE SCHEMA warehouse_private AUTHORIZATION postgres;
REVOKE ALL ON SCHEMA warehouse_private FROM PUBLIC,anon,authenticated,service_role,
 warehouse_readonly,warehouse_backend,warehouse_stock_executor,warehouse_admin_executor;
CREATE FUNCTION warehouse_private.provider_session_window(p_subject uuid,p_session uuid)
RETURNS TABLE(created_at timestamptz,not_after timestamptz)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path=''
AS $bridge$
SELECT s.created_at, s.not_after
FROM auth.sessions AS s
WHERE s.id = p_session AND s.user_id = p_subject
$bridge$;
REVOKE ALL ON FUNCTION warehouse_private.provider_session_window(uuid,uuid)
 FROM PUBLIC,anon,authenticated,service_role,warehouse_readonly,warehouse_backend,
 warehouse_stock_executor,warehouse_admin_executor;
GRANT USAGE ON SCHEMA warehouse_private TO warehouse_auth_executor;
GRANT EXECUTE ON FUNCTION warehouse_private.provider_session_window(uuid,uuid) TO warehouse_auth_executor;
