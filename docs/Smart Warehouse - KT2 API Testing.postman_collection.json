  "item": [
    {
      "name": "00 - Login STAFF (Supabase Auth)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "async function prepareLogin() {",
              "  const url = pm.variables.get('supabaseUrl') || '';",
              "  const key = pm.variables.get('supabasePublicKey') || '';",
              "  const email = (pm.variables.get('staffEmail') || '').trim();",
              "",
              "  if (!/^https:\\/\\/[^/?#]+$/.test(url) || !key || !email) {",
              "    throw new Error('Điền supabaseUrl, supabasePublicKey và staffEmail trong Variables.');",
              "  }",
              "",
              "  const password = await pm.vault.get('kt2StaffPassword');",
              "  if (!password) throw new Error('Tạo hoặc cập nhật kt2StaffPassword trong Local Vault.');",
              "  pm.variables.set('kt2LoginBody', JSON.stringify({ email, password }));",
              "}",
              "",
              "prepareLogin().catch(() => {",
              "  console.error('Kiểm tra cấu hình Supabase và quyền đọc kt2StaffPassword trong Local Vault.');",
              "  pm.execution.skipRequest();",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Supabase Auth trả HTTP 200', () => pm.response.to.have.status(200));",
              "",
              "async function saveSession() {",
              "  const token = pm.response.json()?.access_token;",
              "  if (typeof token !== 'string' || !/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/.test(token)) {",
              "    throw new Error('Supabase không trả access token JWT.');",
              "  }",
              "  await pm.vault.set('kt2AccessToken', token);",
              "  const saved = (await pm.vault.get('kt2AccessToken')) === token;",
              "  pm.test('Access token đã lưu vào Local Vault', () => pm.expect(saved).to.equal(true));",
              "}",
              "",
              "if (pm.response.code === 200) {",
              "  saveSession().catch(() => {",
              "    pm.test('Access token đã lưu vào Local Vault', () => {",
              "      throw new Error('Không lưu được phiên STAFF. Kiểm tra quyền Vault của collection.');",
              "    });",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{supabasePublicKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{kt2LoginBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
          "host": [
            "{{supabaseUrl}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        },
        "description": "Đăng nhập Supabase Auth với email STAFF và mật khẩu từ kt2StaffPassword. Script chỉ lưu access_token vào kt2AccessToken trong Local Vault. Kết quả đăng nhập thuộc phiên làm việc riêng."
      }
    },
    {
      "name": "A - New Transaction Test",
      "description": "Chọn productId và quantityPackages, rồi gửi 01–04. Script lấy mã quét từ API và giữ snapshot cho 02–04.",
      "item": [
        {
          "name": "01 - GET Inventory",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/inventory",
            "description": "Đọc tồn theo productId, lấy mã quét và hệ số từ đơn vị thực tế, rồi lưu một UUID và payload cho toàn bộ đợt A."
          }
        },
        {
