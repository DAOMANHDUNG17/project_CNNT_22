  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const step = pm.info.requestName.slice(0, 2);",
          "const vars = pm.collectionVariables;",
          "const baseUrl = pm.variables.get('baseUrl');",
          "const existingMode = ['05', '06', '07'].includes(step);",
          "const stateKey = existingMode ? 'kt2ExistingRun' : 'kt2NewRun';",
          "const postSteps = ['02', '03', '04', '06', '07'];",
          "const uuid = /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/;",
          "",
          "function existingId() {",
          "  const value = String(vars.get('existingTransactionId') ?? '').trim().toLowerCase();",
          "  if (!uuid.test(value)) throw new Error('Điền một UUID hợp lệ vào existingTransactionId.');",
          "  return value;",
          "}",
          "",
          "function readRun() {",
          "  return JSON.parse(vars.get(stateKey) || 'null');",
          "}",
          "",
          "function saveRun(run) {",
          "  vars.set(stateKey, JSON.stringify(run));",
          "}",
          "",
          "function historyPath(id) {",
          "  return '/api/transactions?transactionId=' + encodeURIComponent(id) + '&limit=1';",
          "}",
          "",
          "async function backendReader() {",
          "  const token = await pm.vault.get('kt2AccessToken');",
          "  if (!token) throw new Error('Local Vault chưa có phiên STAFF.');",
          "",
          "  return async function read(path) {",
          "    const response = await new Promise((resolve, reject) => {",
          "      pm.sendRequest({",
          "        url: baseUrl + path,",
          "        method: 'GET',",
          "        header: { Authorization: 'Bearer ' + token }",
          "      }, (error, result) => {",
          "        if (error) reject(new Error('Không kết nối được ' + path));",
          "        else resolve(result);",
          "      });",
          "    });",
          "    if (response.code !== 200) throw new Error(path + ' trả HTTP ' + response.code);",
          "    return response.json();",
          "  };",
          "}",
          "",
          "async function staffAccess(read) {",
          "  const [profile, points] = await Promise.all([read('/api/auth/me'), read('/api/scan-points/my')]);",
          "  if (profile.role !== 'STAFF' || profile.is_active !== true || profile.user_id == null) {",
          "    throw new Error('Cần phiên STAFF đang hoạt động.');",
          "  }",
          "  const point = points.data?.[0];",
          "  if (points.data?.length !== 1 || point?.is_active !== true || !point.scan_point_id) {",
          "    throw new Error('STAFF cần đúng một phân công điểm quét đang hoạt động.');",
          "  }",
          "  return { userId: String(profile.user_id), scanPointId: point.scan_point_id };",
          "}",
          "",
          "function stockFor(inventory, id) {",
          "  const row = inventory?.data?.find(item => item.product_id === id);",
          "  if (typeof row?.quantity_base !== 'string' || !/^\\d+$/.test(row.quantity_base) || !row.updated_at) {",
          "    throw new Error('Thiếu dữ liệu tồn kho hợp lệ của ' + id + '.');",
          "  }",
          "  return { quantity: row.quantity_base, updatedAt: row.updated_at, active: row.is_active };",
          "}",
          "",
          "function sameStock(stock, expected) {",
          "  return stock.quantity === expected.quantity && stock.updatedAt === expected.updatedAt;",
          "}",
          "",
          "function matchesSnapshot(row, snapshot) {",
          "  return !!row && Object.entries(snapshot).every(([key, value]) => row[key] === value);",
          "}",
          "",
          "function originalStillExists(history, run) {",
          "  return history?.count === 1 && history.data?.length === 1 && matchesSnapshot(history.data[0], run.movement);",
          "}",
          "",
          "",
          "async function prepare() {",
          "  if (step === '05') {",
          "    vars.set(stateKey, '');",
          "    pm.variables.set('existingTransactionId', existingId());",
          "    return;",
          "  }",
          "  const run = readRun();",
          "  if (step === '01') {",
          "    if (run?.next === '02' && !run.pending) saveRun({ ...run, next: 'prepare' });",
          "    return;",
          "  }",
          "",
          "  if (!run || run.next !== step || run.pending || run.baseUrl !== baseUrl) {",
          "    throw new Error('Thiếu bước chuẩn bị, đổi baseUrl hoặc còn POST đang chờ đối chiếu.');",
          "  }",
          "  const original = run.payload;",
          "  if (existingMode && existingId() !== original.transaction_id) {",
          "    throw new Error('existingTransactionId đã đổi. Gửi lại 05 để xác minh UUID mới.');",
          "  }",
          "  const route = existingMode ? '/api/stock-movements/replay' : '/api/stock-movements';",
          "  if (pm.variables.replaceIn(pm.request.url.toString()) !== baseUrl + route ||",
          "      pm.request.body?.raw !== '{{kt2RequestBody}}') {",
          "    throw new Error('URL hoặc mẫu body KT2 đã bị thay đổi.');",
          "  }",
          "",
          "  const isConflict = step === '04' || step === '07';",
          "  if (isConflict && original.quantity_packages >= 2147483647) {",
          "    throw new Error('Số gói gốc đã ở giới hạn DTO. Chạy được replay, nhưng không thể thử cộng thêm 1.');",
          "  }",
          "  const body = isConflict ? { ...original, quantity_packages: original.quantity_packages + 1 } : original;",
          "",
          "  const read = await backendReader();",
          "  const [access, history, inventory] = await Promise.all([",
          "    staffAccess(read), read(historyPath(original.transaction_id)), read('/api/inventory')",
          "  ]);",
          "  if (access.userId !== run.movement.user_id || access.scanPointId !== original.scan_point_id) {",
          "    throw new Error('STAFF hiện tại phải là người thực hiện giao dịch gốc và còn quyền tại điểm quét gốc.');",
          "  }",
          "  const stock = stockFor(inventory, run.movement.product_id);",
          "  if (!sameStock(stock, run.stock)) throw new Error('Tồn kho đã đổi từ bước trước. Đối chiếu trước khi tiếp tục.');",
          "",
          "  if (step === '02') {",
          "    if (history.count !== 0 || history.data?.length !== 0) throw new Error('UUID mới đã xuất hiện trong lịch sử.');",
          "    const units = await read('/api/product-units');",
          "    if (stock.active !== true || !units.data?.some(unit =>",
          "      unit.product_id === run.movement.product_id && unit.product_unit_id === run.movement.product_unit_id &&",
          "      unit.scan_code === original.scan_code && unit.conversion_factor === run.movement.conversion_factor_snapshot)) {",
          "      throw new Error('Sản phẩm, đơn vị hoặc hệ số quy đổi đã đổi. Gửi lại 01.');",
          "    }",
          "  } else if (!originalStillExists(history, run)) {",
          "    throw new Error('UUID gốc không còn tồn tại hoặc dữ liệu lịch sử đã đổi. POST bị chặn.');",
          "  }",
          "",
          "  pm.variables.set('kt2RequestBody', JSON.stringify(body, null, 2));",
          "  saveRun({ ...run, pending: step });",
          "}",
          "",
          "if (step === '01' || step === '05' || postSteps.includes(step)) {",
          "  prepare().catch(error => {",
          "    console.error(error instanceof Error ? error.message : 'Kiểm tra quyền Local Vault và cấu hình KT2.');",
          "    pm.execution.setNextRequest(null);",
          "    pm.execution.skipRequest();",
          "  });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const step = pm.info.requestName.slice(0, 2);",
          "const vars = pm.collectionVariables;",
          "const baseUrl = pm.variables.get('baseUrl');",
          "const existingMode = ['05', '06', '07'].includes(step);",
          "const stateKey = existingMode ? 'kt2ExistingRun' : 'kt2NewRun';",
          "const postSteps = ['02', '03', '04', '06', '07'];",
          "const uuid = /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/;",
          "",
          "function existingId() {",
          "  const value = String(vars.get('existingTransactionId') ?? '').trim().toLowerCase();",
          "  if (!uuid.test(value)) throw new Error('Điền một UUID hợp lệ vào existingTransactionId.');",
          "  return value;",
          "}",
          "",
          "function readRun() {",
          "  return JSON.parse(vars.get(stateKey) || 'null');",
          "}",
          "",
          "function saveRun(run) {",
          "  vars.set(stateKey, JSON.stringify(run));",
          "}",
          "",
          "function historyPath(id) {",
          "  return '/api/transactions?transactionId=' + encodeURIComponent(id) + '&limit=1';",
          "}",
          "",
          "async function backendReader() {",
          "  const token = await pm.vault.get('kt2AccessToken');",
          "  if (!token) throw new Error('Local Vault chưa có phiên STAFF.');",
          "",
          "  return async function read(path) {",
          "    const response = await new Promise((resolve, reject) => {",
          "      pm.sendRequest({",
          "        url: baseUrl + path,",
          "        method: 'GET',",
          "        header: { Authorization: 'Bearer ' + token }",
          "      }, (error, result) => {",
          "        if (error) reject(new Error('Không kết nối được ' + path));",
          "        else resolve(result);",
          "      });",
          "    });",
          "    if (response.code !== 200) throw new Error(path + ' trả HTTP ' + response.code);",
          "    return response.json();",
          "  };",
          "}",
          "",
          "async function staffAccess(read) {",
          "  const [profile, points] = await Promise.all([read('/api/auth/me'), read('/api/scan-points/my')]);",
          "  if (profile.role !== 'STAFF' || profile.is_active !== true || profile.user_id == null) {",
          "    throw new Error('Cần phiên STAFF đang hoạt động.');",
          "  }",
          "  const point = points.data?.[0];",
          "  if (points.data?.length !== 1 || point?.is_active !== true || !point.scan_point_id) {",
          "    throw new Error('STAFF cần đúng một phân công điểm quét đang hoạt động.');",
          "  }",
          "  return { userId: String(profile.user_id), scanPointId: point.scan_point_id };",
          "}",
          "",
          "function stockFor(inventory, id) {",
          "  const row = inventory?.data?.find(item => item.product_id === id);",
          "  if (typeof row?.quantity_base !== 'string' || !/^\\d+$/.test(row.quantity_base) || !row.updated_at) {",
          "    throw new Error('Thiếu dữ liệu tồn kho hợp lệ của ' + id + '.');",
          "  }",
          "  return { quantity: row.quantity_base, updatedAt: row.updated_at, active: row.is_active };",
          "}",
          "",
          "function sameStock(stock, expected) {",
          "  return stock.quantity === expected.quantity && stock.updatedAt === expected.updatedAt;",
          "}",
          "",
          "function matchesSnapshot(row, snapshot) {",
          "  return !!row && Object.entries(snapshot).every(([key, value]) => row[key] === value);",
          "}",
          "",
          "function originalStillExists(history, run) {",
          "  return history?.count === 1 && history.data?.length === 1 && matchesSnapshot(history.data[0], run.movement);",
          "}",
          "",
          "",
          "function check(name, assertion) {",
          "  let passed = false;",
          "  pm.test(name, () => {",
          "    assertion();",
          "    passed = true;",
          "  });",
          "  return passed;",
          "}",
          "",
          "async function prepareNew() {",
          "  const old = readRun();",
          "  if (old?.pending || ['03', '04'].includes(old?.next)) {",
          "    throw new Error('Đợt A đang dở. Giữ UUID ' + old.payload.transaction_id + ' để hoàn tất hoặc đối chiếu.');",
          "  }",
          "  const productId = String(vars.get('productId') ?? '').trim();",
          "  const quantityInput = String(vars.get('quantityPackages') ?? '').trim();",
          "  const quantity = /^\\d+$/.test(quantityInput) ? Number(quantityInput) : NaN;",
          "  if (!productId || !Number.isInteger(quantity) || quantity < 1 || quantity > 2147483646) {",
          "    throw new Error('Điền productId và quantityPackages nguyên từ 1 đến 2147483646.');",
          "  }",
          "",
          "  const stock = stockFor(pm.response.json(), productId);",
          "  if (!stock.active) throw new Error('Sản phẩm ' + productId + ' đã ngừng hoạt động.');",
          "  const read = await backendReader();",
          "  const [access, units] = await Promise.all([staffAccess(read), read('/api/product-units')]);",
          "  const candidates = units.data?.filter(unit => unit.product_id === productId &&",
          "    typeof unit.scan_code === 'string' && unit.scan_code.trim() && unit.product_unit_id != null &&",
          "    Number.isSafeInteger(unit.conversion_factor) && unit.conversion_factor > 0) || [];",
          "  candidates.sort((a, b) => Number(b.is_base_unit === true) - Number(a.is_base_unit === true) ||",
          "    a.conversion_factor - b.conversion_factor || a.scan_code.localeCompare(b.scan_code));",
          "  const unit = candidates[0];",
          "  if (!unit) throw new Error('Không có mã quét và hệ số quy đổi hợp lệ cho ' + productId + '.');",
          "  const amount = BigInt(quantity) * BigInt(unit.conversion_factor);",
          "  const expected = BigInt(stock.quantity) + amount;",
          "  if (expected > 9223372036854775807n) throw new Error('Tồn dự kiến vượt giới hạn BIGINT.');",
          "",
          "  const reuse = old?.next === 'prepare' && old.baseUrl === baseUrl && old.movement.product_id === productId &&",
          "    old.payload.scan_code === unit.scan_code && old.payload.quantity_packages === quantity &&",
          "    old.movement.user_id === access.userId && old.payload.scan_point_id === access.scanPointId;",
          "  const id = reuse ? old.payload.transaction_id : pm.variables.replaceIn('{{$guid}}').toLowerCase();",
          "  if (!uuid.test(id) || (!reuse && id === old?.payload.transaction_id)) throw new Error('Không tạo được UUID mới.');",
          "  const draft = {",
          "    baseUrl,",
          "    next: 'prepare',",
          "    stock,",
          "    payload: {",
          "      transaction_id: id, scan_code: unit.scan_code, scan_point_id: access.scanPointId,",
          "      movement_type: 'IN', quantity_packages: quantity",
          "    },",
          "    movement: {",
          "      transaction_id: id, product_id: productId, product_unit_id: String(unit.product_unit_id),",
          "      scan_code_snapshot: unit.scan_code, scan_point_id: access.scanPointId, user_id: access.userId,",
          "      movement_type: 'IN', quantity_packages: quantity, conversion_factor_snapshot: unit.conversion_factor,",
          "      quantity_base: amount.toString(), inventory_before: stock.quantity, inventory_after: expected.toString()",
          "    }",
          "  };",
          "  vars.set('transactionId', id);",
          "  vars.set('scanCode', unit.scan_code);",
          "  saveRun(draft);",
          "  const history = await read(historyPath(id));",
          "  if (history.count !== 0 || history.data?.length !== 0) {",
          "    vars.set(stateKey, '');",
          "    throw new Error('UUID đã tồn tại. Gửi lại 01 để tạo mã khác.');",
          "  }",
          "  check('Tồn ' + productId + ' = ' + stock.quantity + ' • ' + unit.scan_code + ' × ' + unit.conversion_factor, () => {",
          "    pm.expect(unit.product_id).to.equal(productId);",
          "    pm.expect(history.count, 'UUID chưa có trong lịch sử').to.equal(0);",
          "  });",
          "  saveRun({ ...draft, next: '02' });",
          "}",
          "",
          "async function prepareExisting() {",
          "  const id = existingId();",
          "  const history = pm.response.json();",
          "  if (history.count === 0 && history.data?.length === 0) {",
          "    throw new Error('Không tìm thấy giao dịch với UUID ' + id + '. 06 và 07 bị chặn.');",
          "  }",
          "  const row = history.data?.[0];",
          "  const fields = [",
          "    'transaction_id', 'product_id', 'product_unit_id', 'scan_code_snapshot', 'scan_point_id',",
          "    'user_id', 'movement_type', 'quantity_packages', 'conversion_factor_snapshot',",
          "    'quantity_base', 'inventory_before', 'inventory_after', 'created_at'",
          "  ];",
          "  if (history.count !== 1 || history.data?.length !== 1 || row?.transaction_id !== id ||",
          "      !fields.every(key => row[key] != null) || !row.scan_code_snapshot || !row.scan_point_id ||",
          "      !['IN', 'OUT'].includes(row.movement_type) || !Number.isInteger(row.quantity_packages) ||",
          "      row.quantity_packages < 1 || row.quantity_packages > 2147483647) {",
          "    throw new Error('Response lịch sử thiếu dữ liệu giao dịch gốc hoặc UUID không khớp.');",
          "  }",
          "  check('UUID đã tồn tại • Giao dịch gốc được tìm thấy', () => pm.expect(row.transaction_id).to.equal(id));",
          "  const read = await backendReader();",
          "  const [access, inventory] = await Promise.all([staffAccess(read), read('/api/inventory')]);",
          "  if (access.userId !== row.user_id || access.scanPointId !== row.scan_point_id) {",
          "    throw new Error('Chỉ STAFF đã thực hiện giao dịch và còn quyền tại điểm quét gốc mới chạy được 06–07.');",
          "  }",
          "",
          "  const stock = stockFor(inventory, row.product_id);",
          "  const payload = {",
          "    transaction_id: id, scan_code: row.scan_code_snapshot, scan_point_id: row.scan_point_id,",
          "    movement_type: row.movement_type, quantity_packages: row.quantity_packages",
          "  };",
          "  const movement = Object.fromEntries(fields.map(key => [key, row[key]]));",
          "  saveRun({ baseUrl, next: '06', stock, payload, movement });",
          "  check('STAFF có quyền replay • Tồn hiện tại của ' + row.product_id + ' = ' + stock.quantity, () => {",
          "    pm.expect(access.scanPointId).to.equal(row.scan_point_id);",
          "  });",
          "}",
          "",
          "const status = { '02': 201, '03': 200, '04': 409, '06': 200, '07': 409 };",
          "const next = { '02': '03', '03': '04', '04': 'done', '06': '07', '07': 'done' };",
          "",
          "async function verifyPost() {",
          "  const run = readRun();",
          "  if (run?.pending !== step) throw new Error('Thiếu snapshot của POST hiện tại.');",
          "  const isCreate = step === '02';",
          "  const isReplay = step === '03' || step === '06';",
          "  const correctStatus = check('HTTP ' + status[step], () => pm.response.to.have.status(status[step]));",
          "  let movement = run.movement;",
          "  const validResponse = correctStatus && check(",
          "    isCreate ? 'Tạo mới thành công • is_duplicate = false' :",
          "      isReplay ? 'Replay thành công, không ghi trùng • is_duplicate = true' : 'Conflict bị từ chối • UUID đã tồn tại',",
          "    () => {",
          "      const result = pm.response.json();",
          "      if (!isCreate && !isReplay) {",
          "        pm.expect(result.message).to.equal('Mã giao dịch đã được dùng cho một lượt nhập/xuất khác.');",
          "      } else {",
          "        const message = isCreate ? 'Giao dịch được tạo thành công.' :",
          "          'Giao dịch đã được xử lý trước đó. Hệ thống không ghi trùng và không cập nhật tồn kho lần nữa.';",
          "        pm.expect(result).to.include({ is_duplicate: isReplay, message });",
          "        pm.expect(result.data).to.include(movement);",
          "        if (isCreate) {",
          "          pm.expect(result.data.created_at).to.be.a('string').and.not.be.empty;",
          "          movement = { ...movement, created_at: result.data.created_at };",
          "        }",
          "      }",
          "    }",
          "  );",
          "",
          "  const read = await backendReader();",
          "  const [inventory, history] = await Promise.all([read('/api/inventory'), read(historyPath(run.payload.transaction_id))]);",
          "  const stock = stockFor(inventory, movement.product_id);",
          "  const expected = isCreate ? movement.inventory_after : run.stock.quantity;",
          "  const label = isCreate ? 'Tồn kho tăng đúng hệ số' : 'Tồn kho không bị cập nhật hai lần';",
          "  const validStock = check(label + ' • ' + movement.product_id + ' = ' + stock.quantity, () => {",
          "    pm.expect(stock.quantity).to.equal(expected);",
          "    if (!isCreate) pm.expect(stock.updatedAt, 'updated_at').to.equal(run.stock.updatedAt);",
          "  });",
          "  const validHistory = check('UUID chỉ có đúng một bản ghi gốc', () => {",
          "    pm.expect(originalStillExists(history, { movement })).to.equal(true);",
          "  });",
          "",
          "  if (validResponse && validStock && validHistory) {",
          "    const { pending, ...state } = run;",
          "    saveRun({ ...state, movement, stock, next: next[step] });",
          "  } else {",
          "    pm.execution.setNextRequest(null);",
          "  }",
          "}",
          "",
          "async function evaluate() {",
          "  if (postSteps.includes(step)) return verifyPost();",
          "  if (!check('HTTP 200', () => pm.response.to.have.status(200))) {",
          "    pm.execution.setNextRequest(null);",
          "    return;",
          "  }",
          "  if (step === '01') return prepareNew();",
          "  return prepareExisting();",
          "}",
          "",
          "if (step === '01' || step === '05' || postSteps.includes(step)) {",
          "  evaluate().catch(error => {",
          "    pm.test(step === '05' ? 'Tra cứu UUID và kiểm tra quyền replay' : 'Đối chiếu KT2', () => {",
          "      throw new Error(error instanceof Error ? error.message : 'Kiểm tra quyền Local Vault và phản hồi Backend.');",
          "    });",
          "    pm.execution.setNextRequest(null);",
          "  });",
          "}"
        ]
      }
    }
  ]
}
