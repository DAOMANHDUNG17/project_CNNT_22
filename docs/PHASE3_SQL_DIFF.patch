+ALTER FUNCTION public.record_stock_movement(uuid,bigint,varchar,varchar,varchar,integer)
+  OWNER TO warehouse_stock_executor;
+DO $owner_check$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_proc p JOIN pg_roles r ON r.oid=p.proowner
+    WHERE p.oid=to_regprocedure('public.record_stock_movement(uuid,bigint,character varying,character varying,character varying,integer)')
+      AND r.rolname='warehouse_stock_executor' AND NOT p.prosecdef
+      AND NOT (r.rolcanlogin OR r.rolsuper OR r.rolcreatedb OR r.rolcreaterole OR r.rolreplication OR r.rolbypassrls)
+  ) THEN
+    RAISE EXCEPTION 'Refuse SECURITY DEFINER: owner must first be the restricted NOLOGIN executor';
+  END IF;
+END
+$owner_check$;
+ALTER FUNCTION public.record_stock_movement(uuid,bigint,varchar,varchar,varchar,integer)
+  SECURITY DEFINER;
+GRANT EXECUTE ON FUNCTION public.record_stock_movement(uuid,bigint,varchar,varchar,varchar,integer)
+  TO warehouse_backend;
+-- Database-local default for the actual DDL creator, not a cluster-wide change.
+ALTER DEFAULT PRIVILEGES FOR ROLE postgres REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
+DO $postcheck$
+DECLARE v_oid oid := to_regprocedure('public.record_stock_movement(uuid,bigint,character varying,character varying,character varying,integer)');
+BEGIN
+  IF NOT (SELECT p.prosecdef AND pg_get_userbyid(p.proowner)='warehouse_stock_executor'
+                 AND p.proconfig=ARRAY['search_path=pg_catalog, public, pg_temp']::text[]
+          FROM pg_proc p WHERE p.oid=v_oid)
+     OR has_function_privilege('warehouse_readonly',v_oid,'EXECUTE')
+     OR NOT has_function_privilege('warehouse_backend',v_oid,'EXECUTE')
+     OR EXISTS (SELECT 1 FROM pg_proc p CROSS JOIN LATERAL
+       aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) x
+       WHERE p.oid=v_oid AND x.grantee=0 AND x.privilege_type='EXECUTE')
+     OR has_any_column_privilege('warehouse_stock_executor','public.users','UPDATE')
+     OR has_column_privilege('warehouse_stock_executor','public.users','password_hash','SELECT') THEN
+    RAISE EXCEPTION 'Hardening postcheck failed; transaction must roll back';
+  END IF;
+END
+$postcheck$;
 COMMIT;
