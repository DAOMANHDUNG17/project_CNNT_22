{
  "name": "smart-stationery-warehouse-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Authenticated warehouse REST API for React admin dashboard",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check:db": "node scripts/check-db.js",
    "check:phase2": "node scripts/check-phase2-access.js",
    "check:main": "node scripts/check-backend-main.js",
    "test": "node --test test/*.test.js",
    "test:legacy-unit": "node --test test/api.test.js test/read-api.test.js",
    "test:backend-unit": "node --test test/admin-write.test.js test/auth.test.js test/config.test.js test/contract.test.js test/dashboard-read.test.js test/secure-access.test.js test/stock-write.test.js",
    "test:integration": "node --test --test-concurrency=1 integration/*-real.test.js integration/admin-sql-security.test.js",
    "test:legacy-integration": "node scripts/check-phase2-access.js && node --test --test-concurrency=1 integration/database.test.js integration/read-api.test.js",
    "test:secure-integration": "npm run test:integration",
    "test:all": "npm test && npm run test:integration",
    "setup:test-infra": "node scripts/admin-dashboard/setup-infra.js",
    "setup:test-db": "node scripts/admin-dashboard/bootstrap-test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "redis": "6.3.1"
  }
}
