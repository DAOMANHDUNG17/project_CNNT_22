# TEMPLATE ONLY. Copy to an ignored .env.cloud or a protected external directory.
# Never paste real values into Git. Activation is currently blocked in source.
APP_PROFILE=supabase-cloud
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGINS=http://127.0.0.1:5173
SUPABASE_PROJECT_REF=REPLACE_WITH_APPROVED_PROJECT_REF
SUPABASE_EXPECTED_PROJECT_REF=REPLACE_WITH_SAME_APPROVED_PROJECT_REF
SUPABASE_URL=https://REPLACE_WITH_APPROVED_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PUBLISHABLE_KEY
# Required: confirm actual signing settings; do not guess these values.
SUPABASE_JWT_VERIFICATION=
SUPABASE_JWT_ALGORITHM=
SUPABASE_DB_MODE=direct
PGHOST=db.REPLACE_WITH_APPROVED_PROJECT_REF.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGSCHEMA=public
PGUSER=warehouse_readonly
WRITE_PGUSER=warehouse_backend
# Relative to this env file. No newline/BOM in secret files; CA is a public PEM.
PGPASSWORD_FILE=./.cloud-private/reader-password.txt
WRITE_PGPASSWORD_FILE=./.cloud-private/writer-password.txt
CLOUD_RATE_HMAC_KEY_FILE=./.cloud-private/rate-hmac.txt
PGSSLROOTCERT=./.cloud-private/provider-ca.pem
PGSSLMODE=verify-full
PGPOOL_MAX=3
PGCONNECT_TIMEOUT_MS=5000
PGQUERY_TIMEOUT_MS=5000
